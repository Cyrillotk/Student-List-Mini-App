<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Students</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <div class="container">

    <h1>Students</h1>

    <% if (students.length===0) { %>

      <p class="empty">
        No students yet. Add one below!
      </p>

      <% } else { %>

        <table>

          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Age</th>
              <th>Course</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>

            <% students.forEach(function(student) { %>

              <tr>

                <td>
                  <%= student.name %>
                </td>

                <td>
                  <%= student.email %>
                </td>

                <td>
                  <%= student.age %>
                </td>

                <td>
                  <%= student.course %>
                </td>

                <td>

                  <a href="/students/<%= student._id %>" class="view">
                    View
                  </a>

                  <a href="/students/<%= student._id %>/edit" class="edit">
                    Edit
                  </a>

                  <form action="/students/<%= student._id %>/delete" method="POST" class="delete-form">

                    <button type="submit" class="delete"
                      onclick="return confirm('Are you sure you want to delete this student?')">
                      Delete
                    </button>

                  </form>

                </td>

              </tr>

              <% }); %>

          </tbody>

        </table>

        <% } %>

          <br>

          <a class="btn" href="/students/new">
            + Add New Student
          </a>

  </div>

</body>

</html>